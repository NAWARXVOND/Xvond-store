APP_ENV=production
DATABASE_URL=postgresql+asyncpg://xvond_store:REPLACE_PASSWORD@postgres:5432/xvond_store
POSTGRES_PASSWORD=REPLACE_PASSWORD
ADMIN_API_TOKEN=REPLACE_WITH_RANDOM_48_CHARACTERS
ADMIN_EMAIL=admin@xvond.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
SESSION_SECRET=REPLACE_WITH_RANDOM_64_CHARACTERS
FRONTEND_URL=https://xvond.com/store
EMAIL_FROM=Xvond Store <support@xvond.com>
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_ZOHO_MAILBOX
SMTP_PASSWORD=REPLACE_WITH_ZOHO_APP_PASSWORD
SMTP_STARTTLS=true
TAP_ENABLED=false
TAP_SECRET_KEY=REPLACE_WITH_TAP_LIVE_SECRET_KEY
TAP_MERCHANT_ID=REPLACE_WITH_TAP_MERCHANT_ID
TAP_SOURCE_ID=src_all
TAP_WEBHOOK_URL=https://xvond.com/store-api/v1/payments/tap/webhook
CORS_ORIGINS=https://xvond.com
NEXT_PUBLIC_API_URL=https://xvond.com/store-api/v1
NEXT_PUBLIC_SITE_URL=https://xvond.com/store
NEXT_PUBLIC_BASE_PATH=/store
NEXT_PUBLIC_IMAGE_HOSTNAME=cdn.xvond.com
